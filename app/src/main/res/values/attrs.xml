<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CalendarPicker">
        <attr name="dayTextColor" format="color" />
        <attr name="yearTextColor" format="color" />
        <attr name="firstSelectedDateTextColor" format="color" />
        <attr name="secondSelectedDateTextColor" format="color" />
        <attr name="selectedDateCircleColor" format="color" />
        <attr name="selectedCurrentDateCircleColor" format="color" />
        <attr name="weekoff" format="color" />
        <attr name="presentDotColor" format="color" />
        <attr name="absentDotColor" format="color" />
        <attr name="halfDayDotColor" format="color" />
        <attr name="shortLeaveDotColor" format="color" />
        <attr name="eventDotColor" format="color" />


        <attr name="eventDotColorWhenHighlighted" format="color" />
        <attr name="eventDotColorWhenSelected" format="color" />
        <attr name="highlightedDatesBackgroundColor" format="color" />
        <attr name="highlightedDatesTextColor" format="color" />
        <attr name="titleColor" format="color" />
        <attr name="nextMonthButtonColor" format="color" />
        <attr name="previousMonthButtonColor" format="color" />
        <attr name="yearSelectButtonColor" format="color" />
        <attr name="yearSelectButtonIconColor" format="color" />
        <attr name="yearSelectButtonTextColor" format="color" />
        <attr name="dateRangeTextColor" format="color" />
        <attr name="daysOfWeekTextColor" format="color" />

        <attr name="nextMonthButtonIcon" format="reference" />
        <attr name="previousMonthButtonIcon" format="reference" />

        <attr name="eventDotGravity">
            <flag name="bottom" value="80" />
            <flag name="end" value="8388613" />
            <flag name="start" value="8388611" />
            <flag name="top" value="48" />
        </attr>
    </declare-styleable>


    <!--OTP view-->
    <declare-styleable name="OtpViewTheme">
        <attr format="reference" name="otpViewStyle"/>
    </declare-styleable>

    <declare-styleable name="OtpView">
        <attr format="integer" name="OtpItemCount"/>
        <attr format="dimension" name="OtpItemWidth"/>
        <attr format="dimension" name="OtpItemHeight"/>
        <attr format="dimension" name="OtpItemRadius"/>
        <attr format="dimension" name="OtpItemSpacing"/>
        <attr format="dimension" name="OtpLineWidth"/>
        <attr format="reference|color" name="OtpLineColor"/>
        <attr format="enum" name="OtpViewType">
            <enum name="rectangle" value="0"/>
            <enum name="line" value="1"/>
            <enum name="none" value="2"/>
        </attr>
        <attr name="android:cursorVisible"/>
        <attr name="android:textAllCaps"/>
        <attr format="dimension" name="OtpCursorWidth"/>
        <attr format="reference|color" name="OtpCursorColor"/>
        <attr name="android:itemBackground"/>
        <attr format="boolean" name="OtpHideLineWhenFilled"/>
        <attr format="boolean" name="OtpState_filled"/>
        <attr format="boolean" name="OtpRtlTextDirection"/>
        <attr format="string" name="OtpMaskingChar"/>
    </declare-styleable>


    <declare-styleable name="advDrawerLayout">
        <attr name="adl_customBehavior" format="boolean" />
        <attr name="adl_viewScale" format="float" />
        <attr name="adl_viewScrimColor" format="color" />
        <attr name="adl_viewElevation" format="dimension" />
        <attr name="adl_drawerElevation" format="dimension" />
        <attr name="adl_cardBackgroundColor" format="reference|color" />
    </declare-styleable>

</resources>