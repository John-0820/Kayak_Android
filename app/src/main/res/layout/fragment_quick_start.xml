<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_fragments"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".ui.login.fragments.QuickStart">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/_5sdp"
            android:fontFamily="@font/bricolage_grotesque_regular"
            android:text="Quick Start"
            android:textColor="@color/white"
            android:includeFontPadding="false"
            android:textSize="@dimen/_24sdp" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_75sdp"
            android:id="@+id/ll_quick_start"
            android:layout_marginTop="@dimen/_120dp"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="@dimen/_180sdp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_or"
                android:background="@drawable/bg_new_black"
                android:layout_marginLeft="@dimen/_32dp"
                android:layout_marginRight="@dimen/_32dp"
                android:layout_toStartOf="@+id/tv_or"
                android:id="@+id/rl_time"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="@string/time"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="@dimen/_25sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="@string/select"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_30ssp"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:id="@+id/iv_arrow"
                    android:paddingTop="@dimen/_40sdp"
                    android:layout_marginLeft="@dimen/_120sdp"
                    android:src="@drawable/ic_down"/>

            </RelativeLayout>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_or"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/or"
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/white" />

            <RelativeLayout
                android:layout_width="@dimen/_180sdp"
                android:layout_height="@dimen/_200dp"
                android:background="@drawable/bg_new_black"
                android:layout_toEndOf="@+id/tv_or"
                android:layout_marginLeft="@dimen/_32dp"
                android:layout_marginRight="@dimen/_32dp"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="@string/distance"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_distance_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="@dimen/_25sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="@string/select"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_30ssp" />

                <Spinner
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/tv_distance_value"
                    android:theme="@style/SpinnerTheme"
                    android:visibility="gone"
                    android:id="@+id/sp_distance"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:id="@+id/iv_arrow_d"
                    android:paddingTop="@dimen/_40sdp"
                    android:layout_marginLeft="@dimen/_120sdp"
                    android:src="@drawable/ic_down"/>

            </RelativeLayout>

        </RelativeLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="@dimen/_65sdp"
            android:layout_height="52dp"
            android:layout_below="@+id/ll_quick_start"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/_22sdp"
            android:layout_marginBottom="@dimen/_24dp"
            android:backgroundTint="#89F05B"
            android:fontFamily="@font/bricolage_grotesque_regular"
            android:textStyle="bold"
            android:textSize="@dimen/_7sdp"
            android:text="@string/start"
            android:textColor="@color/black"
            app:cornerRadius="@dimen/_8dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/btn_start"
            android:layout_alignEnd="@+id/btn_start"
            android:layout_marginTop="@dimen/_188dp"
            android:layout_marginEnd="@dimen/_100dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/btn_start"
            android:layout_marginTop="@dimen/_188dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:layout_marginStart="@dimen/_140dp"
            tools:listitem="@layout/item_spinner_distance"
            tools:itemCount="4"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />



    </RelativeLayout>
</ScrollView>