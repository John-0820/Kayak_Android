        android:fontFamily="@font/bebas_neue_"
        android:text="0"
        android:textColor="@color/golden_fizz"
        android:textSize="@dimen/ats_value_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/iv_deadline"
        app:layout_constraintStart_toEndOf="@+id/iv_deadline"
        app:layout_constraintTop_toTopOf="@+id/iv_deadline" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
