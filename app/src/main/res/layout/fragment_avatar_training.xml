    <androidx.media3.ui.PlayerView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fill"
        app:use_controller="false" />
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/ats_icon_size"
        android:layout_height="@dimen/ats_icon_size"
        app:srcCompat="@drawable/ic_avt_pace"
        android:id="@+id/iv_pace"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_6sdp"
        app:layout_constraintTop_toBottomOf="@id/iv_stop"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_pace_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/_6sdp"
        android:fontFamily="@font/bebas_neue_"
        android:text="00:00"
        android:textColor="@color/golden_fizz"
        android:textSize="@dimen/ats_value_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/iv_pace"
        app:layout_constraintStart_toEndOf="@+id/iv_pace"
        app:layout_constraintTop_toTopOf="@+id/iv_pace" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_2sdp"
        app:layout_constraintStart_toEndOf="@+id/tv_pace_value"
        android:fontFamily="@font/bebas_neue_"
        android:text="/500M"
        android:id="@+id/tv_pace_unit"
        android:layout_marginBottom="@dimen/_4sdp"
        android:textColor="@color/white"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pace_value"
        android:textStyle="normal"
        android:textSize="@dimen/ats_unit_text_size" />


    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/_1dp"
        android:background="@color/gray"
        app:layout_constraintTop_toBottomOf="@+id/iv_pace"
        app:layout_constraintEnd_toEndOf="@+id/tv_pace_unit"
        app:layout_constraintStart_toStartOf="@+id/tv_pace_value"
        android:id="@+id/view_pace"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bricolage_grotesque_regular"
        android:text="@string/time"
        android:id="@+id/tv_time"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/view_pace"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time_value"
        app:layout_constraintStart_toStartOf="@+id/view_pace"
        android:layout_marginLeft="@dimen/_2sdp"
        android:textSize="@dimen/ats_pace_time_text_size" />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bebas_neue_"
        android:text="00:00"
        app:layout_constraintStart_toEndOf="@+id/tv_time"
        app:layout_constraintTop_toBottomOf="@+id/view_pace"
        android:textColor="@color/white"
        android:id="@+id/tv_time_value"
        android:layout_marginLeft="@dimen/_6sdp"
        android:textStyle="normal"
        android:textSize="@dimen/ats_pace_time_value_text_size" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/ats_icon_size"
        android:layout_height="@dimen/ats_icon_size"
