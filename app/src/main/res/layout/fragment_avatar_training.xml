        app:layout_constraintTop_toBottomOf="@+id/tv_time_value"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_distance_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/_6sdp"
        android:fontFamily="@font/bebas_neue_"
        android:text="0"
        android:textColor="@color/golden_fizz"
        android:textSize="@dimen/ats_value_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/iv_distance"
        app:layout_constraintStart_toEndOf="@+id/iv_distance"
        app:layout_constraintTop_toTopOf="@+id/iv_distance" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_2sdp"
        app:layout_constraintStart_toEndOf="@+id/tv_distance_value"
        android:fontFamily="@font/bebas_neue_"
        android:text="M"
        android:id="@+id/tv_distance_unit"
        android:layout_marginBottom="@dimen/_4sdp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tv_distance_value"
        android:textStyle="bold"
        android:textSize="@dimen/ats_unit_text_size" />

    <androidx.appcompat.widget.AppCompatImageView
