<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="@dimen/_16dp"
    xmlns:tools="http://schemas.android.com/tools">



    <androidx.cardview.widget.CardView
        android:id="@+id/cl_machine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_120dp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:elevation="@dimen/_2sdp"
        app:cardBackgroundColor="@color/cod_gray"
        app:cardCornerRadius="@dimen/_4sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_6dp"

                app:layout_constraintStart_toStartOf="parent"
                >


                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/program_name"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:textSize="@dimen/_10ssp"
                    android:id="@+id/tv_serial_num"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textColor="@color/white"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_clock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_12dp"
                app:layout_constraintStart_toEndOf="@+id/cl_name">
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tv_workout_name"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_weight="1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:background="@drawable/bg_input_text"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:gravity="center_vertical"
                    android:inputType="text"
                    android:paddingStart="@dimen/_4sdp"
                    android:text="@string/hard_paddling"
                    android:textColor="@color/white" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_distance"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_24dp"
                app:layout_constraintStart_toEndOf="@+id/cl_clock">

                <RelativeLayout
                    android:id="@+id/relativeLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_workout_time"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="@dimen/_26sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_text"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:fontFamily="@font/bricolage_grotesque_regular"
                        android:gravity="center_vertical"
                        android:inputType="text"
                        android:paddingStart="@dimen/_4sdp"
                        android:text="05:00"
                        android:textColor="@color/white" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrow_t"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignEnd="@+id/et_workout_time"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_8dp"
                        android:src="@drawable/ic_down" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/et_workout_time"
                        android:layout_alignStart="@+id/et_workout_time"
                        android:layout_alignEnd="@id/et_workout_time"
                        android:nestedScrollingEnabled="true"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_or"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/et_workout_time"
                        android:layout_alignBottom="@+id/et_workout_time"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@+id/et_workout_time"
                        android:fontFamily="@font/bricolage_grotesque_regular"
                        android:gravity="center"
                        android:text="@string/or"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10ssp" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_workout_distance"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_toEndOf="@+id/tv_or"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_text"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:fontFamily="@font/bricolage_grotesque_regular"
                        android:gravity="center_vertical"
                        android:inputType="text"
                        android:paddingStart="@dimen/_4sdp"
                        android:text="500m"
                        android:textColor="@color/white" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrow_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignEnd="@+id/et_workout_distance"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_8dp"
                        android:src="@drawable/ic_down" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/et_workout_distance"
                        android:layout_alignStart="@+id/et_workout_distance"
                        android:layout_alignEnd="@+id/et_workout_distance"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2" />
                </RelativeLayout>


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_edit_workout"
                    android:layout_width="@dimen/_100dp"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_12dp"
                    android:background="@drawable/bg_rounded_white"
                    android:src="@android:drawable/ic_menu_edit"
                    app:layout_constraintBottom_toBottomOf="parent"

                    app:layout_constraintStart_toEndOf="@+id/relativeLayout"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_save_workout"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_12dp"
                    android:src="@drawable/ic_save_workout"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/relativeLayout"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_delete_workout"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_26sdp"
                    android:src="@drawable/ic_delete_workout"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_edit_workout"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>




