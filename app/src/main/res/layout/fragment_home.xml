<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fragments"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="@dimen/_300sdp"
        android:layout_height="@dimen/_260sdp"
        android:paddingTop="@dimen/_15sdp"
        android:orientation="vertical"
        android:id="@+id/cl_top"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_6sdp"
            android:paddingLeft="@dimen/_6sdp"
            android:paddingRight="@dimen/_6sdp">

            <LinearLayout
                android:layout_width="@dimen/_141sdp"
                android:layout_height="@dimen/_55sdp"
                android:orientation="vertical"
                android:paddingLeft="@dimen/_8sdp"
                android:background="@drawable/bg_new_black"
                android:layout_marginRight="@dimen/_5sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Quick Start"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textSize="@dimen/_9sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Connect device and start training"
                    android:textColor="#40FFFFFF"
                    android:textSize="@dimen/_5sdp" />

                <Button
                    android:layout_width="@dimen/_120dp"
                    android:layout_height="@dimen/_40dp"
                    android:id="@+id/btn_quick_start"
                    android:text="@string/start"
                    android:textAllCaps="false"
                    android:backgroundTint="#89F05B"
                    android:textColor="@color/black"
                    app:cornerRadius="@dimen/_8dp"
                    android:textStyle="normal"
                    android:layout_marginBottom="@dimen/_24dp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_141sdp"
                android:layout_height="@dimen/_55sdp"
                android:orientation="vertical"
                android:paddingLeft="@dimen/_8sdp"
                android:background="@drawable/bg_new_black"
                android:layout_marginRight="@dimen/_5sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Avatar training"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textSize="@dimen/_9sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Connect device and start training"
                    android:textColor="#40FFFFFF"
                    android:textSize="@dimen/_5sdp" />

                <Button
                    android:layout_width="@dimen/_120dp"
                    android:layout_height="@dimen/_40dp"
                    android:id="@+id/btn_avatar_training"
                    android:text="@string/start"
                    android:textAllCaps="false"
                    android:backgroundTint="#89F05B"
                    android:textColor="@color/black"
                    app:cornerRadius="@dimen/_8dp"
                    android:textStyle="normal"
                    android:layout_marginBottom="@dimen/_24dp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_6sdp"
            android:paddingLeft="@dimen/_6sdp"
            android:paddingRight="@dimen/_6sdp">

            <LinearLayout
                android:layout_width="@dimen/_141sdp"
                android:layout_height="@dimen/_55sdp"
                android:orientation="vertical"
                android:paddingLeft="@dimen/_8sdp"
                android:background="@drawable/bg_new_black"
                android:layout_marginRight="@dimen/_5sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Last program training"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textSize="@dimen/_9sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Connect device and start training"
                    android:textColor="#40FFFFFF"
                    android:textSize="@dimen/_5sdp" />

                <Button
                    android:layout_width="@dimen/_120dp"
                    android:layout_height="@dimen/_40dp"
                    android:id="@+id/btn_lpt"
                    android:text="@string/start"
                    android:textAllCaps="false"
                    android:backgroundTint="#89F05B"
                    android:textColor="@color/black"
                    app:cornerRadius="@dimen/_8dp"
                    android:textStyle="normal"
                    android:layout_marginBottom="@dimen/_24dp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_141sdp"
                android:layout_height="@dimen/_55sdp"
                android:orientation="vertical"
                android:paddingLeft="@dimen/_8sdp"
                android:background="@drawable/bg_new_black"
                android:layout_marginRight="@dimen/_5sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Programmable training"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textSize="@dimen/_9sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Connect device and start training"
                    android:textColor="#40FFFFFF"
                    android:textSize="@dimen/_5sdp" />

                <Button
                    android:layout_width="@dimen/_120dp"
                    android:layout_height="@dimen/_40dp"
                    android:id="@+id/btn_programmable_training"
                    android:text="@string/start"
                    android:textAllCaps="false"
                    android:backgroundTint="#89F05B"
                    android:textColor="@color/black"
                    app:cornerRadius="@dimen/_8dp"
                    android:textStyle="normal"
                    android:layout_marginBottom="@dimen/_24dp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_6sdp"
            android:paddingLeft="@dimen/_6sdp"
            android:paddingRight="@dimen/_6sdp">

            <LinearLayout
                android:layout_width="@dimen/_288sdp"
                android:layout_height="@dimen/_70sdp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="@dimen/_8sdp"
                android:background="@drawable/bg_new_black"
                android:layout_marginRight="@dimen/_5sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="\t KayakPro HD\nPaddling Videos"
                    android:includeFontPadding="false"
                    android:id="@+id/tv_title4"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textSize="@dimen/_9sdp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:id="@+id/tv_unit4"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:text="Connect device and start training"
                    android:textColor="#40FFFFFF"
                    android:textSize="@dimen/_5sdp" />

                <Button
                    android:layout_width="@dimen/_120dp"
                    android:layout_height="@dimen/_40dp"
                    android:id="@+id/btn_check_video"
                    android:text="Check it"
                    android:textAllCaps="false"
                    android:backgroundTint="#89F05B"
                    android:textColor="@color/black"
                    app:cornerRadius="@dimen/_8dp"
                    android:textStyle="normal"
                    android:layout_marginBottom="@dimen/_24dp"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_program_history"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_42dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_42dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_top"
        app:layout_constraintVertical_bias="1.0"
        tools:itemCount="2"
        tools:listitem="@layout/item_program_name" />


</androidx.constraintlayout.widget.ConstraintLayout>