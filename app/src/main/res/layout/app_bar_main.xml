<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.login.activity.HomeScreen">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarmain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.KayakPro.AppBarOverlay"
        android:visibility="visible"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/black"
            app:popupTheme="@style/Theme.KayakPro.PopupOverlay">



<!--                <androidx.appcompat.widget.AppCompatTextView-->
<!--                    android:id="@+id/txt_screen_title"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_gravity="center"-->
<!--                    android:textStyle="bold"-->
<!--                    android:fontFamily="@font/bricolage_grotesque_regular"-->
<!--                    android:gravity="center_vertical"-->
<!--                    android:text="@string/quick_start"-->
<!--                    android:textColor="@color/white"-->
<!--                    android:textSize="@dimen/_12ssp"/>-->

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_appbar"
                    android:layout_width="@dimen/_180dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque_regular"
                    android:gravity="center_vertical"
                    android:src="@drawable/ic_logo"
                    />


            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:id="@+id/isConnected"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                android:gravity="center_vertical|end"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/_12dp"
                android:visibility="gone"
                android:background="@color/golden_fizz"
                />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/main_content"
        layout="@layout/content_main" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>